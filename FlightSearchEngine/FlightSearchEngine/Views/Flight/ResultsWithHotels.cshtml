@model IEnumerable<FlightSearchEngine.Models.FlightHotelResult>

@{
    ViewData["Title"] = "Search Results with Hotels";
}

<h2>Flight + Hotel Search Results</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <strong>No results found.</strong>
        <p>Try adjusting your search criteria.</p>
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Flight ID</th>
                <th>Flight Name</th>
                <th>Source</th>
                <th>Destination</th>
                <th>Hotel Name</th>
                <th>Total Cost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FlightId</td>
                    <td>@item.FlightName</td>
                    <td>@item.Source</td>
                    <td>@item.Destination</td>
                    <td>@item.HotelName</td>
                    <td>@item.TotalCost.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
    
    <p class="text-muted">Found @Model.Count() package(s)</p>
}

<div class="mt-3">
    <a asp-controller="Flight" asp-action="Index" class="btn btn-primary">New Search</a>
</div>