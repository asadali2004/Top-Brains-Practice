@model IEnumerable<FlightSearchEngine.Models.FlightResult>

@{
    ViewData["Title"] = "Flight Results";
}

<h2>Flight Results</h2>

@if (Model == null || !Model.Any())
{
    <p>No results found</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>FlightId</th>
                <th>FlightName</th>
                <th>FlightType</th>
                <th>Source</th>
                <th>Destination</th>
                <th>TotalCost</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.FlightId</td>
                    <td>@flight.FlightName</td>
                    <td>@flight.FlightType</td>
                    <td>@flight.Source</td>
                    <td>@flight.Destination</td>
                    <td>@flight.TotalCost</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-controller="Flight" asp-action="Index" class="btn btn-primary">New Search</a>
</div>