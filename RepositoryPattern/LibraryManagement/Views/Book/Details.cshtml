@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="bi bi-book"></i> Book Details
                    </h2>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong class="text-muted">Book ID:</strong>
                        </div>
                        <div class="col-md-9">
                            <span class="badge bg-secondary">#@Model.BookId</span>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong class="text-muted">
                                <i class="bi bi-bookmark-fill"></i> Title:
                            </strong>
                        </div>
                        <div class="col-md-9">
                            <h4 class="text-dark mb-0">@Model.Title</h4>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong class="text-muted">
                                <i class="bi bi-person-fill"></i> Author:
                            </strong>
                        </div>
                        <div class="col-md-9">
                            <h5 class="text-secondary mb-0">@Model.Author</h5>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong class="text-muted">
                                <i class="bi bi-currency-dollar"></i> Price:
                            </strong>
                        </div>
                        <div class="col-md-9">
                            <h4 class="text-success mb-0">@Model.Price.ToString("C")</h4>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <a asp-action="List" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.BookId" 
                       class="btn btn-outline-danger float-end"
                       onclick="return confirm('Are you sure you want to delete this book?');">
                        <i class="bi bi-trash"></i> Delete Book
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>